{
  "name": "futlink",
  "version": "1.0.0",
  "private": true,
  "description": "FutLink: PWA para organizar partidos de fútbol amateur en Bogotá",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w backend",
    "build:web": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "npm run test -w backend",
    "test:web": "npm run test -w frontend",
    "test:watch": "npm run test:watch -w backend",
    "typecheck": "npm run typecheck -w backend",
    "typecheck:web": "npm run typecheck -w frontend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:migrate:down": "npm run db:migrate:down -w backend",
    "db:migrate:status": "npm run db:migrate:status -w backend",
    "db:seed": "npm run db:seed -w backend",
    "admin:create": "npm run admin:create -w backend"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
