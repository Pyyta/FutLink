# Servidor
NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS, separados por coma. En desarrollo, el frontend de Vite.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
BODY_LIMIT=1mb

# Base de datos PostgreSQL con PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave
DB_NAME=Futlink

# Autenticación (Fase 3)
# Genera secretos con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia_por_un_secreto_de_al_menos_32_caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12
RESET_CODE_PEPPER=cambia_por_otro_secreto_de_al_menos_32_caracteres
PASSWORD_RESET_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
PASSWORD_RESET_RATE_LIMIT_MAX=5

# Provisión del primer administrador (npm run admin:create, desde backend/)
# ADMIN_EMAIL=admin@futlink.local
# ADMIN_PASSWORD=cambia_esta_clave_de_admin
